# Required before deployment. Do not commit the real .env file.
DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# Use the official Sub2API image or a private image you are authorized to use.
SUB2API_IMAGE=replace-with-authorized-sub2api-image

POSTGRES_DB=sub2api
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
