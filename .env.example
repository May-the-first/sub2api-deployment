# Copy to .env on the server. Never commit the real file.
DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# Official Sub2API release verified for this deployment template.
SUB2API_IMAGE=weishaw/sub2api:0.2.4

POSTGRES_DB=sub2api
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password

# First-run administrator. Replace locally with a strong unique password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Generate each locally: openssl rand -hex 32
JWT_SECRET=replace-with-64-random-hex-characters
TOTP_ENCRYPTION_KEY=replace-with-64-random-hex-characters
TZ=Asia/Shanghai

# Optional: server-side outbound proxy for upstream access. Never commit credentials.
UPDATE_PROXY_URL=
